# Modèle des variables d'environnement du backend.
# Copiez ce fichier en `.env` (jamais commité) et remplissez les valeurs.
# Ne mettez JAMAIS de vraie valeur dans ce fichier : le dépôt est public.

MONGO_URL=
DB_NAME=
JWT_SECRET=
FRONTEND_URL=

# Compte admin créé au démarrage (et utilisé par les tests backend)
ADMIN_EMAIL=admin@generaquiz.fr
ADMIN_PASSWORD=

# Code cadeau « Premium à vie » (optionnel ; aucun code à vie s'il est vide)
FAMILY_PROMO_CODE=

# Stripe
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
GIFT_STRIPE_MODE=test
GIFT_STRIPE_TEST_SECRET_KEY=
GIFT_STRIPE_TEST_WEBHOOK_SECRET=
GIFT_STRIPE_TEST_PRODUCT_ID=
GIFT_STRIPE_TEST_PRICE_ID=
GIFT_STRIPE_LIVE_SECRET_KEY=
GIFT_STRIPE_LIVE_WEBHOOK_SECRET=
GIFT_STRIPE_LIVE_PRODUCT_ID=
GIFT_STRIPE_LIVE_PRICE_ID=
GIFT_CODE_ENCRYPTION_KEY=

# E-mails (Resend)
RESEND_API_KEY=
SENDER_EMAIL=

# IA
MISTRAL_API_KEY=
EMERGENT_LLM_KEY=
